PORT=3011
JWT_SECRET=change-me-in-production

# MySQL（docker-compose.yml 定义；默认值与之对应）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=fenqun
MYSQL_USER=fenqun
MYSQL_PASSWORD=fenqun-dev-2026
MYSQL_ROOT_PASSWORD=fenqun-root-dev

# SSH 反向隧道（A 方案，Web 终端运维）
SSH_TUNNEL_GATEWAY_USER=fenqun-tunnel
SSH_TUNNEL_USER=root
SSH_AUTHORIZED_KEYS_FILE=/home/fenqun-tunnel/.ssh/authorized_keys

# 异地隧道公网地址（管理面板「异地打开」URL 前缀；生产建议 https 域名）
TUNNEL_PUBLIC_URL=https://kequn.fenqunshuju.com

# 用户管理默认密码（新建用户/重置密码用；首次登录强制修改）
USER_DEFAULT_PASSWORD=Fenqun@123
ARK_API_KEY=your-ark-api-key
ARK_TEXT_MODEL=doubao-seed-2-0-pro-260215
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
SITE_URL=https://creaite.cn/fenqun/system_new

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=your@qq.com

# 易联云小票机
YLY_CLIENT_ID=your-yly-client-id
YLY_CLIENT_SECRET=your-yly-client-secret
YLY_DEFAULT_MACHINE_CODE=your-machine-code
YLY_API_BASE=https://open-api.10ss.net

# 部署脚本（deploy_system*.sh）使用，不在服务器 .env 中
# FENQUN_DEPLOY_PASS=your-ssh-password
